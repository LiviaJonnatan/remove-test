{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "passage_id": {"type": "string"},
          "index": {"type": "integer"},
          "quote": {"type": ["string", "null"]}
        },
        "required": ["passage_id", "index", "quote"],
        "additionalProperties": false
      }
    }
  },
  "required": ["claims"],
  "additionalProperties": false
}
