{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "passages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "passage_id": {"type": "string"},
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "quote": {"type": ["string", "null"]},
                "stance": {"type": "string", "enum": ["support", "oppose", "modify", "clarify", "other"]},
                "ask": {"type": ["string", "null"]},
                "evidence_type": {
                  "type": "array",
                  "items": {"type": "string", "enum": ["data", "legal", "alternative", "cost", "feasibility", "experience"]}
                },
                "section_ref": {"type": "string"}
              },
              "required": ["quote", "stance", "ask", "evidence_type", "section_ref"],
              "additionalProperties": false
            }
          }
        },
        "required": ["passage_id", "claims"],
        "additionalProperties": false
      }
    }
  },
  "required": ["passages"],
  "additionalProperties": false
}
