{
  "displayName": "undersigned-api",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Requests per minute the app served, by route (average over each point)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "60 * sum by (route) (rate(logging_googleapis_com:user_undersigned_api_requests{monitored_resource=\"cloud_run_revision\"}[${__interval}]))"
                },
                "plotType": "STACKED_BAR"
              }
            ],
            "yAxis": {"label": "requests / min", "scale": "LINEAR"}
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 0,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Error rate: 5xx as a share of all responses (%), from Cloud Run",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "100 * (sum(rate(run_googleapis_com:request_count{monitored_resource=\"cloud_run_revision\",service_name=\"undersigned-api\",response_code_class=\"5xx\"}[${__interval}])) or vector(0)) / sum(rate(run_googleapis_com:request_count{monitored_resource=\"cloud_run_revision\",service_name=\"undersigned-api\"}[${__interval}]))"
                },
                "plotType": "LINE",
                "legendTemplate": "5xx share of responses"
              }
            ],
            "yAxis": {"label": "% of responses", "scale": "LINEAR"}
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 4,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "p95 latency inside the app, by route (ms); cold starts not included",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/undersigned_api_latency\" AND resource.type=\"cloud_run_revision\"",
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_95",
                      "groupByFields": ["metric.label.route"]
                    }
                  }
                },
                "plotType": "LINE",
                "minAlignmentPeriod": "300s"
              }
            ],
            "thresholds": [{"value": 1000, "label": "/link alert"}],
            "yAxis": {"label": "ms", "scale": "LINEAR"}
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 4,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Instances, average over each point (at most 2)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/container/instance_count\" AND resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"undersigned-api\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_MEAN",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": ["metric.label.state"]
                    }
                  }
                },
                "plotType": "STACKED_AREA",
                "minAlignmentPeriod": "60s"
              }
            ],
            "yAxis": {"label": "instances", "scale": "LINEAR"}
          }
        }
      }
    ]
  }
}
