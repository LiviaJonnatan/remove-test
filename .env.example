# Register your own key: https://api.data.gov/signup/
# Covers both Regulations.gov and FCC ECFS. 1,000 requests/hour, shared across both.
API_DATA_GOV_KEY=

# ----------------------------- Collector settings

# comma-separated. Every stage follows this, including rule-passages unless RULE_DOCKETS is set.
# The default is the MS2 demo docket (lead and copper). EPA-HQ-OW-2018-0149 is the development
# docket and EPA-HQ-OAR-2017-0355 the transfer docket.
DOCKET_IDS=EPA-HQ-OW-2022-0801

# e.g. 50 for a smoke test; empty = whole docket
MAX_RECORDS=50

# How campaign-builder groups letters: containment (the default, for personalized form letters),
# minhash or exact. CONTAINMENT_THRESHOLD is the share of a campaign's template a letter must contain.
GROUPING_METHOD=containment
CONTAINMENT_THRESHOLD=0.5

# A fixed list of comment ids to fetch instead of the first MAX_RECORDS. The default is the 40
# record MS2 sample from DOCKET_IDS above. Leave it empty to pull by MAX_RECORDS or the whole docket.
RECORD_IDS_FILE=/app/samples/ms2_ids.txt
SKIP_ATTACHMENTS=0

# k/n to split one docket across n containers; empty = 1/1
SHARD=

# any long random string; used by data-processor to hash signer names
SIGNER_HASH_KEY= 

GCP_PROJECT="ac215-undersigned"
GOOGLE_APPLICATION_CREDENTIALS="/secrets/undersigned-key.json"
GCS_BUCKET="ac215-undersigned-data"
WANDB_API_KEY=