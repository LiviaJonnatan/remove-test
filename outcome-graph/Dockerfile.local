# The API for `docker compose --profile app up`: same code as the Cloud Run image, but the rule
# bundles are mounted from ../data/derived instead of baked in, and the agent is on.
FROM python:3.12-slim-bookworm
ENV UV_PROJECT_ENVIRONMENT=/opt/venv PATH="/opt/venv/bin:$PATH" PYTHONUNBUFFERED=1 OUTCOME_DATA_ROOT=/data
RUN pip install --no-cache-dir uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src/ ./src/
COPY web/dist/ ./web/dist/
CMD ["sh", "-c", "uvicorn server:app --app-dir src --host 0.0.0.0 --port ${PORT:-8080}"]
